@host = http://127.0.0.1:5087

### Login
# @name login
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "Admin123!"
}

###
@token = {{login.response.body.token}}

### Listar usuarios
GET {{host}}/api/users
Authorization: Bearer {{token}}

### Obtener uno
GET {{host}}/api/users/1
Authorization: Bearer {{token}}

### Crear
POST {{host}}/api/users
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "username": "ana",
  "email": "ana@demo.local",
  "password": "Ana12345",
  "estado": true
}

### Actualizar
PUT {{host}}/api/users/2
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "username": "ana",
  "email": "ana.rios@demo.local",
  "estado": false
}

### Eliminar
DELETE {{host}}/api/users/2
Authorization: Bearer {{token}}
